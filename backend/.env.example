# عنوان استقبال USDT على BSC (BEP20) — عام فقط، لا تضع المفتاح الخاص أبداً
BINANCE_BEP20_ADDRESS=0x2315f8b7dbc150c4b674a614697df9bba90645fc

# سري لتوقيع JWT — يُولَّد تلقائياً إذا تُرك فارغاً أو كان ضعيفاً
SECRET_KEY=

# الرابط العام للتطبيق (يظهر في رابط الدعوة وCORS)
APP_BASE_URL=https://hilal-ai-8s01.onrender.com

# production يُغلق /api/docs و /api/redoc — استخدم development محلياً فقط عند الحاجة
ENVIRONMENT=production

# شبكة BSC — RPCs مجانية
BSC_RPC_URLS=https://bsc-dataseed.binance.org,https://bsc-rpc.publicnode.com
USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
MIN_CONFIRMATIONS=1

# لوحة المدير: رابط /admin — غيّر كلمة المرور قبل النشر
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SESSION_MINUTES=480

# مكافحة تخمين TxID
PAYMENT_MAX_FAILURES=5
PAYMENT_BLOCK_MINUTES=15

# JWT
JWT_EXPIRE_MINUTES=1440

# حدود الرفع
MAX_UPLOAD_MB=5

# Rate limiting
RATE_LIMIT_GLOBAL=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_HEAVY=5/minute

# نطاقات CORS مسموحة (افصلة بفاصلة). اتركها فارغة لاستخدام القائمة الافتراضية الآمنة.
CORS_ORIGINS=

# الإعلانات مقابل النقاط
# معرّف اختبار رسمي من Google — استبدله بمعرّف الإعلان الحقيقي قبل النشر
ADMOB_REWARDED_ID=ca-app-pub-3940256099942544/5224354917
# رابط إعلان ويب يُفتح في المتصفح عندما لا يكون التطبيق أصلياً
WEB_AD_DIRECT_LINK=https://example.com
AD_DAILY_LIMIT=5
AD_MIN_SECONDS=25

# تكلفة كل عملية بالنقاط
# مساعد الدراسة مجاني 100% بلا حدود؛ المحادثة العادية 30 رسالة/يوم ثم اشتراك
FREE_CHAT_DAILY_LIMIT=30
POINTS_STUDIO=0.5
POINTS_IMAGE=1
POINTS_AUDIO=1
POINTS_VIDEO=2

# اختياري: توكن HuggingFace لرفع حصة مساحات Gradio
HF_TOKEN=
