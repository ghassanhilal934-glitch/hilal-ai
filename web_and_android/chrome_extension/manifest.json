{
  "manifest_version": 3,
  "name": "Hilal AI — مساعدك العربي",
  "version": "1.0.0",
  "description": "واجهة Hilal AI في أي صفحة: محادثة وصور وصوت وفيديو بمحركات مجانية.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:8000/*", "https://*.hf.space/*", "https://*.onrender.com/*", "https://*.trycloudflare.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hilal AI",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
